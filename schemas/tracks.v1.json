{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "nesttrace.tracks v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "tracks", "note"],
  "properties": {
    "schema": {"const": "nesttrace.tracks"},
    "version": {"const": 1},
    "note": {"type": "string"},
    "tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "pin_id", "points"],
        "properties": {
          "id": {"type": "string", "pattern": "^track-[0-9]+$"},
          "pin_id": {"type": ["string", "null"]},
          "points": {
            "type": "array",
            "minItems": 2,
            "items": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}
          }
        }
      }
    }
  }
}
