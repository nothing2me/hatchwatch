# Copy to .env. DATABASE_URL here is for running Next.js on the host against the Compose database.
DATABASE_URL=postgresql://nesttrace:nesttrace@localhost:5433/nesttrace
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-32-plus-random-bytes
# Host path for media when running Next.js or CLIs outside Docker (Compose overrides with /media).
MEDIA_ROOT=../media
SEED_ADMIN_EMAIL=admin@nesttrace.local
SEED_ADMIN_PASSWORD=change-me
# Optional: password for the demo viewer account, used only when the viewer is first created.
SEED_VIEWER_PASSWORD=
MAX_UPLOAD_MB=500
TEST_DATABASE_URL=postgresql://nesttrace:nesttrace@localhost:5433/nesttrace_test
# Live simulator feed (live-chunk.v1 watcher). The Compose web container always runs the one watcher
# (LIVE_FEED is fixed to 1 in docker-compose.yml), so there is no LIVE_FEED line here. A host `npm run dev`
# leaves the watcher off; to run it on the host instead, stop Compose web and start with LIVE_FEED=1 npm run dev.
# Two watchers on one database would race. LIVE_ROOT is the host path outside Docker; Compose mounts it at /sim-public.
LIVE_ROOT=../../artifacts/public
LIVE_FADE_MINUTES=5
LIVE_ARCHIVE_MINUTES=20
LIVE_KEEP=40
# Laptop LAN IP for phone cameras (macOS: ipconfig getifaddr en0). Must be the LAN IP or a hostname other than
# `localhost`: localhost duplicates the Caddy site address and Caddy refuses the config. Phones open https://LAN_HOST:3443/cam.
LAN_HOST=192.168.1.20
# Phone recordings (git-ignored). Host path outside Docker; Compose mounts ./recordings at /recordings.
RECORDINGS_ROOT=../recordings
# Delete recordings older than this many hours (swept hourly).
RECORDING_RETENTION_HOURS=72
# Set RECORDING=off to stop recording phones (live view still works).
RECORDING=
# ffmpeg converts finished segments to mp4; without it the .avi files are kept. Defaults to `ffmpeg` on PATH.
FFMPEG_PATH=
# Live detection worker (dashboard/worker). Shared secret for the internal routes /api/internal/*; generate with:
# openssl rand -hex 32. Empty keeps detection off: the routes then refuse every request and the worker exits at start.
WORKER_TOKEN=
# Simulated patrol for live demos: 1 turns it on (needs the live feed). Each live digging site gets one random
# outcome: found and protected, no eggs found, found but protection forgotten, or never visited. Entries are signed
# "Demo patrol (simulated)" and outcomes are NOT tied to the simulator's truth. Leave unset for real use.
DEMO_PATROL=
