generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  VOLUNTEER
  VIEWER
}

enum ActivityLevel {
  LOW
  MEDIUM
  HIGH
}

enum CameraStatus {
  ONLINE
  OFFLINE
}

enum JobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

enum JobStage {
  probe
  calibrate
  extract
  detect
  track
  render
  persist
}

enum AlertKind {
  DIGGING
  TRACK_ONLY
  NO_TURTLE
  DANGER
}

enum AlertStatus {
  NEW
  REVIEWED
  DISMISSED
  FIELD_CONFIRMED
  HATCHED
  LOST
  ARCHIVED
}

model User {
  id            String              @id @default(cuid())
  email         String              @unique
  passwordHash  String
  name          String
  role          Role                @default(VIEWER)
  createdAt     DateTime            @default(now())
  disabledAt    DateTime?
  siteEvents    SiteEvent[]
  videos        Video[]
  notes         AlertNote[]
  statusChanges AlertStatusChange[]
  auditLogs     AuditLog[]
}

model Zone {
  id            String        @id @default(cuid())
  code          String        @unique
  name          String
  /// GeoJSON Polygon: { type: "Polygon", coordinates: [[[lng, lat], ...]] }
  outline       Json
  activityLevel ActivityLevel @default(LOW)
  cameras       Camera[]
  alerts        Alert[]
  createdById   String?
  liveChunks    LiveChunk[]
}

model Camera {
  id          String       @id @default(cuid())
  code        String       @unique
  zoneId      String
  zone        Zone         @relation(fields: [zoneId], references: [id])
  lng         Float
  lat         Float
  /// Compass bearing in degrees, 0 = north, clockwise.
  headingDeg  Float
  fovDeg      Float        @default(44)
  /// Length of the drawn view cone in metres.
  rangeM      Float        @default(250)
  status      CameraStatus @default(ONLINE)
  /// { pairs: [{ px: [x, y], lngLat: [lng, lat] }] (4), frameWidth, frameHeight, rmseM }
  calibration Json?
  videos      Video[]
  alerts      Alert[]
}

model Video {
  id             String      @id @default(cuid())
  cameraId       String
  camera         Camera      @relation(fields: [cameraId], references: [id])
  source         VideoSource @default(UPLOAD)
  /// Path relative to MEDIA_ROOT.
  path           String
  /// Pure-motion variant, relative to MEDIA_ROOT (simulation imports).
  pureMotionPath String?
  /// Research run id for simulation imports.
  simRunId       String?
  originalName   String
  durationS      Float?
  fps            Float?
  width          Int?
  height         Int?
  uploadedById   String?
  uploadedBy     User?       @relation(fields: [uploadedById], references: [id])
  liveChunkId    String?
  liveChunk      LiveChunk?  @relation(fields: [liveChunkId], references: [id], onDelete: SetNull)
  createdAt      DateTime    @default(now())
  jobs           Job[]
  tracks         Track[]
  alerts         Alert[]

  @@index([cameraId, createdAt])
  @@index([simRunId])
}

enum VideoSource {
  UPLOAD
  SIMULATION
}

enum EvidenceTier {
  TWO_CAMERA
  SINGLE_CAMERA
}

model Job {
  id          String    @id @default(cuid())
  videoId     String
  video       Video     @relation(fields: [videoId], references: [id])
  status      JobStatus @default(QUEUED)
  stage       JobStage?
  progress    Float     @default(0)
  attempts    Int       @default(0)
  error       String?
  heartbeatAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, createdAt])
}

model Track {
  id            String  @id @default(cuid())
  videoId       String
  video         Video   @relation(fields: [videoId], references: [id])
  /// [{ t, px, py, lng?, lat? }]
  points        Json
  startT        Float
  endT          Float
  geoReferenced Boolean @default(false)
  label         String
  /// Site (alert) this trail was matched to; null for an unmatched trail.
  alertId       String?
  alert         Alert?  @relation(fields: [alertId], references: [id], onDelete: Cascade)
  /// Index into the dashboard trail palette (pin order); null = unmatched (grey).
  colorIndex    Int?

  @@index([videoId])
  @@index([alertId])
}

model Alert {
  id                    String              @id @default(cuid())
  videoId               String
  video                 Video               @relation(fields: [videoId], references: [id])
  cameraId              String
  camera                Camera              @relation(fields: [cameraId], references: [id])
  zoneId                String
  zone                  Zone                @relation(fields: [zoneId], references: [id])
  kind                  AlertKind
  message               String
  score                 Float?
  lng                   Float?
  lat                   Float?
  radiusM               Float               @default(0.9)
  startT                Float
  endT                  Float
  status                AlertStatus         @default(NEW)
  outsideCalibratedArea Boolean             @default(false)
  evidenceTier          EvidenceTier?
  simulated             Boolean             @default(false)
  createdAt             DateTime            @default(now())
  notes                 AlertNote[]
  statusChanges         AlertStatusChange[]
  events                SiteEvent[]
  detectedAt            DateTime?
  /// 1 = level-1 (DANGER); 0 = ordinary site.
  level                 Int                 @default(0)
  /// DANGER alerts: the nest site the person came near.
  siteId                String?
  site                  Alert?              @relation("DangerSite", fields: [siteId], references: [id], onDelete: Cascade)
  dangers               Alert[]             @relation("DangerSite")
  tracks                Track[]

  @@index([status, createdAt])
  @@index([siteId])
  @@index([status])
}

model AlertNote {
  id        String   @id @default(cuid())
  alertId   String
  alert     Alert    @relation(fields: [alertId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  body      String
  createdAt DateTime @default(now())
}

model AlertStatusChange {
  id        String      @id @default(cuid())
  alertId   String
  alert     Alert       @relation(fields: [alertId], references: [id])
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  from      AlertStatus
  to        AlertStatus
  createdAt DateTime    @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String
  targetType String
  targetId   String
  details    Json?
  createdAt  DateTime @default(now())
}

model SiteEvent {
  id        String   @id @default(cuid())
  alertId   String
  alert     Alert    @relation(fields: [alertId], references: [id], onDelete: Cascade)
  type      String
  author    String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  note      String?
  at        DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([alertId, at])
}

model LiveChunk {
  id          String   @id
  sequence    Int
  zoneId      String
  zone        Zone     @relation(fields: [zoneId], references: [id])
  startedAt   DateTime
  importedAt  DateTime @default(now())
  mediaPruned Boolean  @default(false)
  videos      Video[]
}
